# Browser-visible key: restrict by HTTP referrer and Map Tiles API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Alternative: Cesium ion asset that resolves to Google Photorealistic 3D Tiles.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_ION_ASSET_ID=2275207
# WGS84 ellipsoid height, not elevation above sea level. Calibrate against your tiles.
VITE_ORIGIN_HEIGHT=0
